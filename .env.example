# Environment Variables Example
# Copy to .env.local for local development

# EmailJS Configuration (Server-Side)
# These should NOT be prefixed with NEXT_PUBLIC_ to ensure they are available only on the server
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key_aka_access_token # CRITICAL for security